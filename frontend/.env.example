# NeuroNudge Frontend Configuration
# VITE_API_BASE_URL: Leave empty for default Vite proxy to localhost:8000
VITE_API_BASE_URL=""

# VITE_USE_MOCKS: Set to "true" to run with built-in realistic mock backend responses,
# or "false" to connect to the teammate Python/FastAPI backend at localhost:8000.
VITE_USE_MOCKS="true"
